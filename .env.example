# Configure these as private Sites/Cloudflare secrets before enabling Admin mode.
# Never commit the actual passwords or expose them to the browser.
ADMIN_MODE_PASSWORD_PRIMARY=
ADMIN_MODE_PASSWORD_SECONDARY=

# Optional future Google Sheets/Drive API bridge.
# GOOGLE_SHEETS_API_URL=

# Firebase Web App configuration (public client configuration).
# Set these in the hosting environment before deploying to Firebase App Hosting.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tef-inventory-bib.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tef-inventory-bib
VITE_FIREBASE_APP_ID=1:970198541323:web:1f36afe8347c9d2184930e
VITE_FORCE_FIREBASE_AUTH=false
